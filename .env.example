# TollRail402 Environment Configuration
# Copy to .env and customize for your local or Algorand TestNet setup.

# Operating Mode: "local_demo" or "algorand_testnet"
# Note: Never silently falls back from algorand_testnet to local_demo.
TOLLRAIL_MODE=local_demo

# Database URL (PostgreSQL preferred for production, SQLite fallback for local demo)
# Example PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/tollrail402
DATABASE_URL=sqlite:///./tollrail402.db

# Server Secret Key for encrypting demo agent keys at rest (change in production!)
TOLLRAIL_KEY_ENCRYPTION_SECRET=tollrail402-local-dev-secret-key-change-me

# Algorand TestNet Configuration (Algonode public endpoints)
ALGOD_ADDRESS=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_ADDRESS=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=
ALGORAND_NETWORK=algorand:testnet

# USDC Algorand Standard Asset ID on TestNet (Circle TestNet USDC = 10458941)
USDC_ASSET_ID=10458941

# Merchant / API Provider Recipient Wallet Address (Algorand TestNet address)
# Leave blank on first boot to auto-generate a deterministic local demo recipient address
MERCHANT_ALGORAND_ADDRESS=

# Optional: Deployed Payment Channel Escrow Smart Contract App ID on Algorand TestNet
ESCROW_APP_ID=0

# Optional: Server Port
PORT=3000
HOST=0.0.0.0
